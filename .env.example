# Database Configuration (Local Docker PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nutrition_app"

# FatSecret API (https://platform.fatsecret.com/api/)
FATSECRET_CONSUMER_KEY="your_fatsecret_consumer_key"
FATSECRET_CONSUMER_SECRET="your_fatsecret_consumer_secret"

# Feature flag — set to "false" to disable FatSecret integration (default: enabled)
FATSECRET_ENABLED="true"

# Better Auth
BETTER_AUTH_SECRET="generate-a-strong-random-secret-for-production"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# App Settings
NODE_ENV="development"

# Playwright E2E Tests
PLAYWRIGHT_TEST_BASE_URL="http://localhost:3000"

# Feature Flags
USE_MOCK_FATSECRET="false"

# Vercel Blob Storage (https://vercel.com/docs/storage/vercel-blob)
# Required for user photo uploads (custom foods & dishes)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxx"

# Resend (Email delivery)
RESEND_API_KEY="your_resend_api_key"
EMAIL_FROM="Nutrition App <no-reply@yourdomain.com>"
